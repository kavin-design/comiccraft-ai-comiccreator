# =====================================================================
# ComicCraft — Single Google Gemini API Key Configuration
# =====================================================================

# Google Gemini API Key (Required, from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifiers (Outline, Story, and Artwork)
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
IMAGEN_MODEL=imagen-3.0-generate-002

# Server Port
PORT=3000
